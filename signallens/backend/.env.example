# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./signallens.db

# Server-side only. Never prefix a secret with VITE_, because frontend variables ship to the browser.
HF_TOKEN=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

# Zero-shot text classification. Confirm your provider serves this model before relying on it.
HF_TEXT_MODEL=facebook/bart-large-mnli
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models

# Optional image classification. Reserved for a later increment, not used yet.
HF_IMAGE_MODEL=openai/clip-vit-base-patch32

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=10
STALE_AFTER_HOURS=6
SEED_DEMO_DATA=true
